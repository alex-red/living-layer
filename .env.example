# Copy to .env at the repository root. Never put keys in VITE_* variables.
PORT=4310
DATA_DIR=.data

MODEL_API_KEY=
META_SPARK_MODEL=muse-spark-1.3
META_SAM_MODEL=sam-3.1
# Live calls stay off until this is true.
META_LIVE_ENABLED=false
# Counts attempted outbound requests (including failed calls), persisted per UTC day.
META_MAX_REQUESTS_PER_DAY=20
META_TIMEOUT_MS=30000

HA_URL=
HA_TOKEN=
HA_ENTITY_ID=
# Optional: more lights that extra placement rules may switch, comma-separated.
HA_EXTRA_ENTITY_IDS=
HA_LIVE_ENABLED=false
