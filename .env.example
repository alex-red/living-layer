# Copy to .env at the repository root. Never put keys in VITE_* variables.
PORT=43431
# The address the API server listens on. `bun run start` keeps it on loopback; `bun run dev`
# sets 0.0.0.0, so a phone or another machine on your network can open the lab.
HOST=127.0.0.1
DATA_DIR=.data

MODEL_API_KEY=
META_SPARK_MODEL=muse-spark-1.3
META_SAM_MODEL=sam-3.1
META_IMAGE_MODEL=muse-image-1.0
# Live calls stay off until this is true.
META_LIVE_ENABLED=false
# The most live Meta calls may cost per UTC day, in USD. A call that could pass it is refused
# before it is sent. The spending readout in the lab's top bar can change it; this is the default.
META_DAILY_SPEND_LIMIT_USD=10
META_TIMEOUT_MS=30000

# Optional, experimental: SAM 3D Objects refines a fixture's shape from its photo crop.
# On this machine through mlx-spatial (Python 3.13, `pip install mlx-spatial`, and the 14 GB
# appautomaton/sam-3d-objects-mlx weights): about 10 minutes a thing on an M4 Pro.
# Or on fal.ai with FAL_KEY, billed by fal. See docs/plans/sam3d-experiment.md.
# Off until this is true, whatever else is set.
SAM3D_ENABLED=false
SAM3D_MLX_WEIGHTS=
SAM3D_MLX_BIN=mlx-spatial-sam3d
FAL_KEY=

# Home Assistant, for switching lights, switches, fans and toggle helpers. Easiest: leave these empty
# and sign in from the lab (Home Assistant → Devices it can switch), then tick the devices. Or set the
# address (with its port) and a long-lived token (your profile in Home Assistant → Security) here. Only ticked devices are switched; set
# HA_LIVE_ENABLED=false to switch nothing at all.
HA_URL=
HA_TOKEN=
HA_LIVE_ENABLED=true
# Optional: devices named here instead of in the lab. The main light, more lights, and switch.*,
# fan.* or input_boolean.* entities, comma-separated.
HA_ENTITY_ID=
HA_EXTRA_ENTITY_IDS=
HA_SWITCH_ENTITY_IDS=

# Optional: show Living Layer's own entities in Home Assistant (e.g. binary_sensor.ll_office_presence)
# through MQTT discovery. Entities are made in the lab; nothing is published until one exists.
# mqtt://host:1883 or mqtts://host:8883, with credentials below, never in the URL. Demo mode never
# publishes. Usually the Mosquitto add-on's address and a Home Assistant user made for it.
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_BASE_TOPIC=livinglayer
MQTT_LIVE_ENABLED=false
# Optional: lights and switches switched over MQTT instead of Home Assistant's API, for homes without
# a token. Each is an entity id and the topic the device reports its state on; it takes
# {"state":"ON"} on <topic>/set, as Zigbee2MQTT devices do. Comma-separated.
# e.g. light.desk_lamp=zigbee2mqtt/Desk lamp,switch.fan=zigbee2mqtt/Fan
MQTT_DEVICES=

# Network cameras shared with scripts/share-camera.sh are found over mDNS. Where mDNS is
# blocked, list their WHEP URLs here, comma-separated (e.g. http://192.168.1.20:8889/cam/whep).
# An rtsp:// URL is a camera only the server reads: it can be watched with no tab open, but a
# tab can't play it. Watching needs ffmpeg; `bun run fetch-model` adds finding lost things by
# appearance (about 22 MB into DATA_DIR).
CAMERA_STREAMS=

# Cameras saved in the lab by their RTSP URL play in the tab through mediamtx, which the server
# runs when it is installed (`brew install mediamtx`): WebRTC at the camera's own frame rate,
# and one connection to the camera however many read it. `off`, or no mediamtx, falls back to
# the server's MJPEG preview. It takes this port (WHEP) and the two after it (RTSP, then WebRTC
# media over UDP). WHEP stays on loopback, as the lab's routes forward to it. Under `bun run dev`
# the WebRTC media is also offered on your network, for a lab opened from another machine. With a
# GPU tracker set below, RTSP is also served on the network to that node alone: user `gpu`, its
# token as the password, and only from its address when its host resolves.
CAMERA_RELAY=mediamtx
CAMERA_RELAY_PORT=43433

# Optional: the GPU tracker node (services/gpu-tracker), which the live watcher also follows
# things with. Its URL (http://<gpu-host>:43450) and its TRACKER_TOKEN; used only when both are
# set. Demo mode never calls it. GPU_TRACKER_HOST (the machine as ssh reaches it) is read only
# by `bun run gpu-tracker`, to deploy and stop it.
GPU_TRACKER_URL=
GPU_TRACKER_TOKEN=

# A phone can stand in as the camera: the lab shows a QR code, the phone opens a page on this
# port (HTTPS, since phone browsers only share the camera over it) and streams to the lab over
# WebRTC. Nothing listens on the network until a phone is paired. Without a certificate a
# self-signed one is made in DATA_DIR, which the phone asks you to accept once; a trusted one
# (e.g. from mkcert) skips that. Set the host if the QR code points at the wrong address.
REMOTE_CAMERA_PORT=43432
REMOTE_CAMERA_HOST=
REMOTE_CAMERA_CERT=
REMOTE_CAMERA_KEY=

# How uploaded photos are stored: webp (default, lossless, same pixels, about 30% smaller than
# PNG) or png. Spark is sent the stored WebP; SAM and Muse Image are sent PNG, converted when
# sent. Older runs keep their source.png and are still read.
FRAME_FORMAT=webp

# Evidence (runs, jobs and their saved pictures under DATA_DIR/evidence) older than this many
# days is deleted at startup and then daily. A run the desk still uses (its memory, or a run
# one of those names) is kept. 0 keeps everything. Captured rooms in .data/rooms are never touched.
EVIDENCE_RETENTION_DAYS=30

# Item fits and room renders run in this many Bun Workers, so a scan never holds up other
# requests. Unset picks a small pool (two at most); 0 runs them on the main thread, as the tests do.
# COMPUTE_WORKERS=2
