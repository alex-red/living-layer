{
  "name": "livinglayer",
  "version": "0.1.0",
  "description": "Give everyday objects a memory so your smart home can react to them.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex-red/living-layer.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "build": "bun run typecheck && bun run --filter @livinglayer/web build",
    "start": "bun apps/server/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:browser": "playwright test",
    "test:browser:strict": "BROWSER_STRICT=1 playwright test",
    "bench": "bun scripts/room-bench.ts; bun scripts/fit-bench.ts",
    "bench:room": "bun scripts/room-bench.ts",
    "bench:fit": "bun scripts/fit-bench.ts",
    "bench:at": "bun scripts/bench-at.ts",
    "room": "bun scripts/room-view.ts",
    "sheet": "bun scripts/prop-sheet.ts",
    "ref": "bun scripts/ref-match.ts",
    "check": "bun run format:check && bun run typecheck && bun run test && bun run build",
    "verify": "bun scripts/verify.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "doctor": "bun scripts/doctor.ts",
    "fetch-model": "bun scripts/fetch-model.ts",
    "smoke": "bun scripts/smoke.ts",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,html,svg,json}\" \"packages/**/*.{ts,json}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,json}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,html,svg,json}\" \"packages/**/*.{ts,json}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,json}\""
  },
  "dependencies": {
    "@fastify/static": "10.1.7",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@meta-sam/parser": "0.1.0",
    "fastify": "^5.6.0",
    "mqtt": "5.16.1",
    "onnxruntime-node": "1.31.1",
    "openai": "^6.0.0",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/bun": "1.4.4",
    "@types/node": "^24.0.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@webgpu/types": "0.1.74",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
