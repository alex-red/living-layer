{
  "name": "livinglayer",
  "version": "0.1.0",
  "description": "Give everyday objects a memory so your smart home can react to them.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex-red/living-layer.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "build": "bun run typecheck && bun run --filter @livinglayer/web build",
    "start": "bun apps/server/src/index.ts",
    "typecheck": "tsrs --noEmit --fast",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:browser": "playwright test",
    "test:browser:strict": "BROWSER_STRICT=1 playwright test",
    "browser": "bun scripts/browser.ts",
    "trace": "bun scripts/trace.ts",
    "bench": "bun scripts/room-bench.ts; bun scripts/fit-bench.ts",
    "bench:room": "bun scripts/room-bench.ts",
    "bench:fit": "bun scripts/fit-bench.ts",
    "bench:rooms": "bun scripts/rooms-bench.ts",
    "bench:at": "bun scripts/bench-at.ts",
    "bench:track": "bun scripts/track-bench.ts",
    "bench:intent": "bun scripts/intent-bench.ts",
    "bench:brush": "bun scripts/brush-bench.ts",
    "assist": "bun scripts/assist-replay.ts",
    "brush": "bun scripts/brush.ts",
    "reset": "bun scripts/reset.ts",
    "room": "bun scripts/room-view.ts",
    "draft": "bun scripts/draft.ts",
    "calib": "bun scripts/calib.ts",
    "runs": "bun scripts/runs.ts",
    "sheet": "bun scripts/prop-sheet.ts",
    "ref": "bun scripts/ref-match.ts",
    "ci": "bun run format:check && bun run typecheck && bun run test && bun run build",
    "verify": "bun scripts/verify.ts",
    "commit": "bun scripts/commit.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "doctor": "bun scripts/doctor.ts",
    "fetch-model": "bun scripts/fetch-model.ts",
    "smoke": "bun scripts/smoke.ts",
    "format": "oxfmt \"apps/**/*.{ts,tsx,css,html,svg,json}\" \"packages/**/*.{ts,json}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,json}\"",
    "format:check": "oxfmt --check \"apps/**/*.{ts,tsx,css,html,svg,json}\" \"packages/**/*.{ts,json}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,json}\""
  },
  "dependencies": {
    "@fastify/static": "10.1.7",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@meta-sam/parser": "0.1.0",
    "fastify": "^5.6.0",
    "mqtt": "5.16.1",
    "onnxruntime-node": "1.31.1",
    "openai": "^6.0.0",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/bun": "1.4.4",
    "@types/node": "^24.0.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "@webgpu/types": "0.1.74",
    "oxfmt": "0.75.0",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typescript": "7.1.0-beta",
    "vite": "8.3.5"
  }
}
