{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 100,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/",
    "**/dist/",
    ".data/",
    "test-results/",
    "playwright-report/",
    "bun.lock",
    "licenses/meta-sam-LICENSE.txt",
    "testdata/sam-mug.json",
    "**/*.svg"
  ]
}
